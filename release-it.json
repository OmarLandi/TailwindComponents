{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "docs/CHANGELOG.md",
      "header": "# Changelog",
      "commitUrlFormat": "https://github.com/OmarLandi/TailwindComponents/commit/{{hash}}",
      "compareUrlFormat": "https://github.com/OmarLandi/TailwindComponents/compare/{{previousTag}}...{{currentTag}}"
    }
  }
}
